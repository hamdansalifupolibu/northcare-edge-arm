# NorthCare AI API — development example (never commit real secrets)
NORTHCARE_ENV=development
# Local preferred form. Hosted providers (Render/etc.) often give postgresql:// —
# the app rewrites that to postgresql+asyncpg:// automatically.
DATABASE_URL=postgresql+asyncpg://northcare@127.0.0.1:5432/northcare
DEV_AUTH_SECRET=dev-only-change-me-not-for-production
CURSOR_SIGNING_SECRET=dev-cursor-signing-secret-change-me
SYNC_PROTOCOL_VERSION=1
# Reach demonstration APIs (default false; development/test only)
# Hosted AT sandbox demos: set true with NORTHCARE_ENV=development (not production telecom).
NORTHCARE_REACH_DEMO_ENABLED=false
NORTHCARE_REACH_DEMO_ORGANISATION_ID=org-dev-001
NORTHCARE_REACH_DEMO_FACILITY_ID=fac-dev-001
# Africa's Talking USSD sandbox adapter (T1) — default false; development/test only
# Hosted Render demo: enable + MODE=sandbox only. MODE=live is rejected.
NORTHCARE_REACH_AT_USSD_ENABLED=false
NORTHCARE_REACH_AT_USSD_MODE=sandbox
# Long unguessable path secret (generate locally; never commit real value)
NORTHCARE_REACH_AT_USSD_CALLBACK_SECRET=
# Comma-separated sandbox service codes from the AT dashboard (example: *384*XXXX#)
# Demo sandbox channel currently used: *384*91620#
NORTHCARE_REACH_AT_USSD_SERVICE_CODES=
# Hosted demo template (empty secrets): .env.hosted.sandbox.example
# Deploy: docs/development/REACH_HOSTED_SANDBOX_DEPLOY.md
# Optional Firebase (leave empty → Firebase verifier unconfigured)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
API_HOST=0.0.0.0
API_PORT=8000
