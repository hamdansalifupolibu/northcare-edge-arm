        { "key": "4", "label": "Poor feeding or weakness", "createsRequest": false },
        { "key": "5", "label": "Immunisation and routine care", "createsRequest": false },
        {
          "key": "6",
          "label": "Request a CHPS worker",
          "createsRequest": true,
          "category": "childHealth",
          "requestType": "routine"
        },
        { "key": "0", "label": "Emergency help", "goto": "emergency" },
