      ],
      "prohibitions": [
        "noSymptomClassification",
        "noMedicine",
        "noDosage",
        "noRiskScore"
      ]
    },
    "nutrition": {
      "title": "NUTRITION SUPPORT",
      "informationPolicy": "demonstrationContentOnly",
      "options": [
        { "key": "1", "label": "Pregnant woman", "createsRequest": false },
        { "key": "2", "label": "Breastfeeding mother", "createsRequest": false },
        { "key": "3", "label": "Baby under 6 months", "createsRequest": false },
        { "key": "4", "label": "Child 6 to 24 months", "createsRequest": false },
        { "key": "5", "label": "Child 2 to 5 years", "createsRequest": false },
        {
          "key": "6",
          "label": "Request nutrition support",
          "createsRequest": true,
          "category": "nutrition",
          "requestType": "routine"
        },
        { "key": "0", "label": "Emergency help", "goto": "emergency" },
        { "key": "9", "label": "Back" }
      ],
      "prohibitions": [
        "noMalnutritionClassification",
        "noAnthropometricStatus",
        "noTreatmentRecommendation"
      ]
    },
    "requestChps": {
      "title": "Request a CHPS worker",
      "steps": [
        {
          "step": 1,
          "prompt": "Select reason",
          "options": [
            { "key": "1", "label": "Pregnancy or newborn", "category": "pregnancyNewborn" },
            { "key": "2", "label": "Child health", "category": "childHealth" },
            { "key": "3", "label": "Nutrition", "category": "nutrition" },
            { "key": "4", "label": "Referral or follow-up", "category": "referralFollowUp" },
            { "key": "5", "label": "Other health concern", "category": "generalChps" },
            { "key": "0", "label": "Emergency help", "goto": "emergency" },
            { "key": "9", "label": "Back" }
          ]
        },
        { "step": 2, "prompt": "Enter community, town or nearest landmark" },
        { "step": 3, "prompt": "Enter or confirm a callback phone number" },
        {
          "step": 4,
          "prompt": "Consent to share contact and location with an authorised health worker"
        },
        {
          "step": 5,
          "returns": [
            "privacySafeReferenceCode",
            "privateSixDigitStatusPinShownOnce",
            "genericConfirmation",
            "reminderToUse112ForImmediateDanger"
          ]
        }
      ],
      "defaultRequestType": "routine",
      "automaticClientCreate": false
    },
    "checkStatus": {
      "inputs": ["referenceCode", "sixDigitStatusPin"],
      "allowedPublicStates": [
        "Request received",
        "Waiting for review",
        "Health worker acknowledged",
        "Contact attempt recorded",
        "Escalated for further support",
        "Request handled",
        "Request cancelled"
      ],
      "mustNotExpose": [
        "category",
        "pregnancyStatus",
        "childHealthConcern",
        "nutritionConcern",
        "emergencyDescription",
        "contactNumber",
        "community",
        "workerName",
        "facility",
        "clinicalNotes",
        "priority",
        "referralInformation"
      ],
      "requirementsForImplementation": [
        "storePinHashOnly",
        "rateLimiting",
        "abuseProtection"
      ]
    },
    "language": {
      "options": [
        { "key": "1", "label": "English", "status": "implemented" },
        { "key": "2", "label": "Dagbanli — planned", "status": "planned" },
        { "key": "3", "label": "Hausa — planned", "status": "planned" },
        { "key": "4", "label": "Dagaare — planned", "status": "planned" },
        { "key": "5", "label": "Request language assistance", "status": "assistance" },
        { "key": "9", "label": "Back" }
      ],
      "fabricateTranslations": false,
      "aiTranslationForPublicHealth": false
    },
    "askNorthCare": {
      "title": "ASK NORTHCARE",
      "engine": "approvedFaqOnly",
      "llm": false,
      "language": "en",
      "honesty": [
        "informationSupportOnly",
        "notClinicalAdvice",
        "notADiagnosis",
        "emergenciesDial112"
      ],
      "disclaimer": "Not a diagnosis. Emergencies: call 112. For care, talk to a health worker.",
      "menuOptions": [
        { "key": "1", "faqKey": "what_is_reach", "label": "What is NorthCare Reach?" },
        { "key": "2", "faqKey": "request_chps", "label": "How do I request a CHPS visit?" },
        { "key": "3", "faqKey": "status_pin", "label": "How does my status PIN work?" },
        { "key": "4", "faqKey": "hours", "label": "CHPS or clinic hours" },
        { "key": "5", "faqKey": "emergency_112", "label": "Emergency - call 112" },
        {
          "key": "6",
          "label": "Request worker follow-up",
          "createsRequest": true,
          "category": "generalChps",
          "requestType": "routine",
          "note": "Uses existing create flow after location/phone/consent — never auto-created from a question alone"
        },
        { "key": "0", "label": "Emergency help", "goto": "emergency" },
        { "key": "9", "label": "Back" }
      ],
      "freeText": {
        "enabled": true,
        "matcher": "approvedKeywordFaqOnly",
        "onNoMatch": "offerWorkerFollowUpOrEmergencyOrBack",
        "doesNot": [
          "diagnose",
          "prescribe",
          "dosage",
          "createClient",
          "createReferral",
          "callLlm",
          "inventDagbanli"
        ]
      },
      "sourcePack": "services/api/src/northcare_api/reach/ussd_at/ask_faq.py",
      "prohibitions": [
        "noDiagnosis",
        "noMedication",
        "noDosage",
        "noGenerativeClinicalChat",
        "noOnDeviceQwenDependency",
        "noAutoClientOrReferralFromQuestion"
      ]
    }
  },
  "forbiddenClaims": [
    "liveShortcodeExists",
    "telecomGatewayConnected",
    "smsActive",
    "realNetworkBilling",
