      "title": "EMERGENCY HELP",
      "mandatoryBanner": "If someone is in immediate danger, call 112 now.",
      "options": [
        {
          "key": "1",
          "label": "End and call 112",
          "createsRequest": false,
          "behaviour": "instructEndSessionAndDial112"
        },
        {
          "key": "2",
          "label": "Send location for urgent human review",
          "createsRequest": true,
          "category": "emergency",
          "requestType": "emergencyAssistance",
          "collects": [
            "personNeedingHelpCategory",
            "communityOrLandmark",
            "contactNumber",
            "consentToShareContactAndLocation"
          ]
        },
        {
          "key": "3",
          "label": "Request an urgent CHPS callback",
          "createsRequest": true,
          "category": "emergency",
          "requestType": "urgentContact",
          "collects": [
            "communityOrLandmark",
            "contactNumber",
            "consentToContact"
          ]
        },
        { "key": "9", "label": "Back", "createsRequest": false }
      ],
      "confirmationCopy": [
        "Emergency coordination simulation",
        "Request received",
        "If someone is in immediate danger, call 112 now."
      ],
      "forbiddenWording": [
        "Ambulance dispatched",
        "Ambulance called",
        "Emergency medically confirmed",
        "Severe case detected",
        "Major emergency",
        "Moderate emergency"
      ]
    },
    "pregnancyNewborn": {
      "title": "PREGNANCY & NEWBORN CARE",
      "informationOptions": ["1", "2", "3", "4", "5"],
      "informationPolicy": "unapprovedDemonstrationPlaceholder",
      "options": [
        { "key": "1", "label": "Care during pregnancy", "createsRequest": false },
        { "key": "2", "label": "Labour and warning signs", "createsRequest": false },
        { "key": "3", "label": "Care after delivery", "createsRequest": false },
        { "key": "4", "label": "Newborn care", "createsRequest": false },
        { "key": "5", "label": "Breastfeeding", "createsRequest": false },
        {
          "key": "6",
          "label": "Request a CHPS worker",
          "createsRequest": true,
          "category": "pregnancyNewborn",
          "requestType": "routine"
        },
        { "key": "0", "label": "Emergency help", "goto": "emergency" },
        { "key": "9", "label": "Back" }
      ],
      "prohibitions": [
        "noDiagnosis",
        "noMedication",
        "noDosage",
        "noFreeFormChatbot"
      ]
    },
