# NorthCare AI — environment variable placeholders ONLY
# Copy to .env (never commit .env)
# EXPO_PUBLIC_* values are bundled into the mobile client — NEVER put private secrets there.

# --- Mobile public configuration (client-visible) ---
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_FIREBASE_API_KEY=replace-me-public-firebase-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=example.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=example-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=example.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:android:0000000000000000000000

# --- Backend (server-only) ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FIREBASE_PROJECT_ID=example-project
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.local.json
FIRESTORE_DATABASE_ID=(default)
CORS_ALLOWED_ORIGINS=http://localhost:8081
LOG_LEVEL=info

# --- AI / language (server-side preferred) ---
GHANANLP_API_URL=
GHANANLP_API_KEY=
AI_PROVIDER=
AI_API_KEY=

# --- Stitch tooling (local scripts only; never commit real key) ---
STITCH_API_KEY=
STITCH_PROJECT_ID=749026157623860355
