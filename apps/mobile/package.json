{
  "name": "northcare-ai-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-sqlite ./node_modules/jest/bin/jest.js",
    "spot-test:phase-c": "node scripts/phase-c-spot-test.mjs",
    "prepare:offline-ai-model": "node scripts/prepare-bundled-offline-ai-model.mjs",
    "install:offline-ai-emulator": "node scripts/install-offline-ai-emulator.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "prebuild:demo": "npm run prepare:offline-ai-model && npx expo prebuild --platform android --clean",
    "build:demo-apk": "cd android && gradlew.bat :app:assembleRelease",
    "doctor": "npx expo-doctor",
    "postinstall": "npx patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.8",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "llama.rn": "0.12.8",
    "northcare-ai-project": "file:../..",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "whisper.rn": "^0.2.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "^29.5.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
