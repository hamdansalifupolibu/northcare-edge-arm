# Public Expo variables only. Never put private secrets in EXPO_PUBLIC_* keys.
EXPO_PUBLIC_APP_ENV=development
# Sync API base URL (no trailing slash). Leave empty to keep sync unavailable.
# Local FastAPI: http://10.0.2.2:8000 (emulator) or http://<lan-ip>:8000 (device)
# Firebase demo sync: https://us-central1-northcare-ai.cloudfunctions.net/api
EXPO_PUBLIC_API_BASE_URL=
# Temporary development-only: skip login/PIN and open worker home after splash.
# Leave unset/false for hackathon demos — judges must see real sign-in.
# Requires __DEV__ and EXPO_PUBLIC_APP_ENV=development. Never enable for production builds.
# EXPO_PUBLIC_DEV_AUTH_BYPASS=true
# Embedded demo accounts (Hamdan / Salma / Takiya). On by default when APP_ENV=development.
# Set true on a sideload APK that uses APP_ENV=production but still needs offline demo login.
# EXPO_PUBLIC_DEMO_LOCAL_AUTH=true
# Shared demo sync password (must match DEMO_SYNC_PASSWORD on Firebase Functions). Development only.
# Hamdan: hammydanny@gmail.com or hamdansalifupolibu@gmail.com — Mama0599545544@ or NorthCareDemo1!. Salma/Takiya: NorthCare@123 — see HACKATHON_DEMO_PACK.md
# EXPO_PUBLIC_DEV_SYNC_DEMO_PASSWORD=NorthCareDemo1!
# Show onboarding after every cold start in development (splash → onboarding → login).
# Default is on in development; set false to skip onboarding during UI work.
# EXPO_PUBLIC_DEV_ALWAYS_SHOW_ONBOARDING=true
# Auto-seed synthetic demo clients/referrals/reminders on first launch (development only).
# EXPO_PUBLIC_DEMO_AUTO_SEED=true
# Auto-copy bundled offline AI from APK assets on first launch.
# EXPO_PUBLIC_BUNDLED_OFFLINE_AI=true
