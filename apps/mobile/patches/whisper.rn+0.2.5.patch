+  public static float[] decodeAudioFile(File file) throws IOException {
+    boolean isWav = false;
+    try (FileInputStream fis = new FileInputStream(file)) {
+      byte[] magic = new byte[4];
+      if (fis.read(magic) == 4) {
+        isWav = (magic[0] == 'R' && magic[1] == 'I' && magic[2] == 'F' && magic[3] == 'F');
+      }
+    }
+    if (isWav) {
+      Log.d(NAME, "Detected WAV file, using direct PCM decoder");
+      return decodeWaveFile(file);
+    }
+    Log.d(NAME, "Non-WAV file detected, using MediaCodec decoder for: " + file.getName());
+    return decodeCompressedAudio(file);
+  }
